                <div className="bg-[#FAF3EC] p-5 rounded-2xl border border-[#EFE2D4] space-y-2">
                  <div className="flex justify-between"><span>Paket {pkg.name}:</span><span className="font-bold">{formatRupiah(pkg.price)}</span></div>
                  {extraChildren > 0 && <div className="flex justify-between text-[#694E40]"><span>+{extraChildren} Anak Tambahan:</span><span>{formatRupiah(extraChildrenFee)}</span></div>}
                  {extraDurationMin > 0 && <div className="flex justify-between text-[#694E40]"><span>+{extraDurationMin} Menit Ekstra:</span><span>{formatRupiah(extraDurationFee)}</span></div>}
                  <div className="flex justify-between text-[#694E40]"><span>Transportasi ({distanceKm} km):</span><span>{transport.isConfirmed ? formatRupiah(transport.fee) : 'Menunggu Konfirmasi Tim'}</span></div>
                  {addonsList.map((a, i) => (
                    <div key={i} className="flex justify-between text-[#694E40]">
                      <span>{a.name}:</span>
                      <span>{a.isStartingPrice ? `${formatRupiah(a.subtotal)}* (Harga Mulai)` : formatRupiah(a.subtotal)}</span>
