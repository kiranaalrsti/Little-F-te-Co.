                    <option value="character">Little Character (Mulai Rp150.000 - Konfirmasi Vendor)</option>
                    <option value="double">Double Delight (Mulai Rp350.000 - Konfirmasi Vendor)</option>
                  </select>
                </div>
                <div className="p-3 bg-[#FAF3EC] rounded-2xl border border-[#EFE2D4]">
                  <label className="block font-bold mb-1">Lilin Angka Estetik</label>
                  <select value={candleType} onChange={e => setCandleType(e.target.value)} className="w-full p-2 rounded-xl border border-[#DECFC0] bg-white text-xs">
