                <h2 className="font-serif text-2xl font-bold text-brand-cocoa">Langkah 9: Syarat & Persetujuan</h2>
                <div className="p-3 bg-[#FAF3EC] rounded-2xl border border-[#EFE2D4] text-[11px] leading-relaxed max-h-36 overflow-y-auto">
                  <p>1. Durasi acara standar 2 jam.</p>
                  <p>2. Properti backdrop dan dekorasi disewakan oleh Little Fête & Co.</p>
                  <p>3. Reschedule disampaikan minimal H-7 dari tanggal acara.</p>
                </div>
                <label className="flex items-start space-x-2 cursor-pointer">
                  <input type="checkbox" checked={agreeTerms} onChange={e => setAgreeTerms(e.target.checked)} className="mt-0.5" />
                  <span className="font-semibold text-brand-cocoa">Saya menyetujui seluruh Syarat & Ketentuan Pemesanan Little Fête & Co. *</span>
                </label>
                <label className="flex items-start space-x-2 cursor-pointer">
                  <input type="checkbox" checked={promoConsent} onChange={e => setPromoConsent(e.target.checked)} className="mt-0.5" />
                  <span className="text-[#694E40]">(Opsional) Saya bersedia menerima informasi promo istimewa dari Little Fête & Co.</span>
                </label>
              </div>
            )}

            {step === 10 && (
              <div className="text-center py-6 space-y-4 text-xs">
                <div className="w-16 h-16 rounded-full bg-brand-pink mx-auto flex items-center justify-center text-brand-cocoa font-serif text-2xl font-bold border border-brand-pinkDark/40">
                  LF
                </div>
                <h2 className="font-serif text-2xl font-bold text-brand-cocoa">Siap Mengajukan Pesanan</h2>
                <p className="text-[#694E40] max-w-md mx-auto leading-relaxed">
                  Setelah tombol ditekan, sistem kami akan langsung menetapkan Personal in Charge (PIC) resmi yang akan mendampingi pesta Anda.
                </p>
                <button onClick={handleSubmit} className="px-8 py-3 rounded-full bg-brand-pink hover:bg-brand-pinkDark text-brand-cocoa hover:text-white font-bold text-xs tracking-wider shadow-md transition border border-brand-pinkDark/40">
                  KIRIM PENGAJUAN BOOKING SEKARANG
                </button>
              </div>
            )}

            <div className="mt-6 pt-4 border-t border-[#F0E5D8] flex justify-between text-xs font-semibold">
