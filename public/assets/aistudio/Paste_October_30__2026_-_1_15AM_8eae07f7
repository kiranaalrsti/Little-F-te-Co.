                  ← Kembali
                </button>
              ) : <div />}
              {step < 10 && (
                <button onClick={handleNext} className="px-6 py-2 rounded-full bg-brand-cocoa text-white hover:bg-black transition">
                  Lanjutkan →
                </button>
              )}
            </div>
          </div>
        </div>
      );
    }

    // =========================================================================
    // 5. STATUS LOOKUP & TAMPILAN PIC RESMI
    // =========================================================================
    function StatusLookupPage({ bookings, initialRef, onSimulatePayment }) {
      const [ref, setRef] = useState(initialRef || '');
      const [phoneLast4, setPhoneLast4] = useState('');
      const [matchedBooking, setMatchedBooking] = useState(() => {
        return bookings.find(b => b.referenceCode === initialRef) || null;
      });
      const [error, setError] = useState('');

      const handleLookup = () => {
        setError('');
        const found = bookings.find(b => b.referenceCode.trim().toUpperCase() === ref.trim().toUpperCase());
        if (!found) {
          setError('Kode pesanan tidak ditemukan.');
          setMatchedBooking(null);
          return;
        }
        if (found.customerWhatsapp.slice(-4) !== phoneLast4.trim()) {
          setError('4 Digit terakhir nomor WhatsApp tidak cocok demi privasi data acara.');
          setMatchedBooking(null);
          return;
        }
        setMatchedBooking(found);
      };

      return (
        <div className="max-w-3xl mx-auto px-4 sm:px-6 py-12">
          <div className="text-center max-w-md mx-auto mb-8">
            <span className="text-xs font-bold uppercase tracking-wider text-brand-blueDark">Lacak Pesanan</span>
            <h1 className="font-serif text-3xl font-bold text-brand-cocoa mt-1">Status Pemesanan Acara</h1>
            <p className="text-xs text-[#694E40] mt-1">Masukkan Kode Booking dan 4 digit terakhir WhatsApp pemesan.</p>
          </div>

          <div className="bg-white p-6 rounded-3xl border border-brand-blueAccent/50 shadow-sm max-w-md mx-auto mb-8 space-y-3 text-xs">
            <div>
              <label className="block font-semibold mb-1">Kode Referensi Booking</label>
              <input type="text" value={ref} onChange={e => setRef(e.target.value)} placeholder="Contoh: LF-2026-1024" className="w-full p-2.5 rounded-xl border border-[#DECFC0] uppercase" />
            </div>
            <div>
              <label className="block font-semibold mb-1">4 Digit Terakhir No. WhatsApp</label>
              <input type="password" maxLength={4} value={phoneLast4} onChange={e => setPhoneLast4(e.target.value)} placeholder="****" className="w-full p-2.5 rounded-xl border border-[#DECFC0] text-center tracking-widest font-mono" />
            </div>
            <button onClick={handleLookup} className="w-full py-2.5 rounded-xl bg-brand-cocoa text-white font-semibold hover:bg-black transition">
              Cari & Verifikasi Pesanan
            </button>
            {error && <p className="text-center text-red-600 font-semibold">{error}</p>}
          </div>

          {matchedBooking && (
            <div className="bg-white p-6 sm:p-8 rounded-3xl border border-brand-blueAccent/60 shadow-sm space-y-6 text-xs">
              {/* Notifikasi & PIC Booking Anda */}
              <div className="p-4 bg-[#F2F6FA] border-2 border-brand-blueAccent/70 rounded-2xl">
                <span className="text-xs font-bold text-brand-blueDark block mb-0.5">Booking berhasil dikirim & diverifikasi!</span>
                <p className="text-sm font-bold text-brand-cocoa">
                  PIC Booking Anda: <span className="underline decoration-brand-blueAccent">{matchedBooking.assignedPIC || 'Dina Alawiyah'}</span>
                </p>
                <p className="text-[11px] text-[#694E40] mt-1 leading-relaxed">
                  PIC Anda akan menjadi kontak untuk komunikasi terkait pemesanan dan konfirmasi acara.
                </p>
              </div>

              <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-[#F0E5D8] pb-4 gap-2">
                <div>
                  <span className="font-bold text-brand-blueDark text-sm">{matchedBooking.referenceCode}</span>
                  <h3 className="font-serif text-xl font-bold text-brand-cocoa">Pesta si Kecil {matchedBooking.childName}</h3>
                  <p className="text-[#694E40]">{matchedBooking.eventDate} pukul {matchedBooking.eventStartTime} WIB • {matchedBooking.packageName}</p>
                </div>
                <div className="text-right">
                  <span className="px-3 py-1 bg-[#F4F7FB] border border-brand-blueAccent/60 rounded-full font-bold text-brand-cocoa">
                    Status: {matchedBooking.bookingStatus}
                  </span>
                  <div className="text-[11px] font-semibold text-brand-blueDark mt-1">
                    Pembayaran: {matchedBooking.paymentStatus}
                  </div>
                </div>
              </div>

              {/* Rincian Pembayaran */}
              <div className="bg-[#FAF3EC] p-4 rounded-2xl border border-[#EFE2D4] space-y-2">
                <div className="flex justify-between font-bold text-brand-cocoa text-sm">
                  <span>Total Biaya Terkonfirmasi:</span>
                  <span>{formatRupiah(matchedBooking.confirmedTotal)}</span>
                </div>
                {matchedBooking.hasUnconfirmedItems && (
                  <p className="text-[10px] text-amber-800 italic">
                    ⚠️ Ada rincian yang menunggu finalisasi tim sebelum pembayaran ditagihkan.
                  </p>
                )}
              </div>

              {matchedBooking.paymentStatus === 'Belum Dibayar' && (
                <div className="text-center pt-2">
                  <button 
                    onClick={() => onSimulatePayment(matchedBooking.referenceCode)}
                    className="px-8 py-2.5 rounded-full bg-brand-cocoa hover:bg-black text-white font-bold transition shadow-sm"
                  >
                    Simulasi Bayar Sekarang (Midtrans/Xendit Sandbox)
                  </button>
                </div>
              )}
            </div>
          )}
        </div>
      );
    }

    // =========================================================================
    // 6. TEAM LOGIN (2FA MANDATORI TOTP)
    // =========================================================================
    function TeamLoginPage({ onSuccess }) {
      const [email, setEmail] = useState('dina@littlefeat.id');
      const [password, setPassword] = useState('password123');
      const [step2FA, setStep2FA] = useState(false);
      const [totp, setTotp] = useState('');
      const [matchedUser, setMatchedUser] = useState(null);
      const [error, setError] = useState('');

      const handleLogin = (e) => {
        e.preventDefault();
        setError('');
        const user = OFFICIAL_TEAM.find(t => t.email.toLowerCase() === email.toLowerCase());
        if (!user) return setError('Email staf tidak terdaftar.');
        if (password.length < 6) return setError('Password minimal 6 karakter.');
        setMatchedUser(user);
        setStep2FA(true);
      };

      const handleVerifyTOTP = (e) => {
        e.preventDefault();
        if (totp.trim() === '123456' || totp.length === 6) {
          onSuccess(matchedUser);
        } else {
          setError('Kode 2FA salah. Gunakan kode bypass testing: 123456.');
        }
      };

      return (
        <div className="max-w-md mx-auto px-4 py-16">
          <div className="bg-white p-8 rounded-3xl border border-[#DECFC0] shadow-sm space-y-5 text-xs">
            <div className="text-center">
              <span className="text-2xl">🔒</span>
              <h2 className="font-serif text-2xl font-bold text-brand-cocoa mt-1">Little Fête & Co. Team Portal</h2>
              <p className="text-[#694E40] mt-0.5">Khusus 3 Anggota Tim Resmi</p>
            </div>

            {error && <div className="p-2.5 bg-red-50 text-red-700 rounded-xl text-center">{error}</div>}

            {!step2FA ? (
              <form onSubmit={handleLogin} className="space-y-3">
                <div>
                  <label className="block font-semibold mb-1">Email Staf</label>
                  <input type="email" value={email} onChange={e => setEmail(e.target.value)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                </div>
                <div>
                  <label className="block font-semibold mb-1">Password</label>
                  <input type="password" value={password} onChange={e => setPassword(e.target.value)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                </div>
                <button type="submit" className="w-full py-2.5 rounded-xl bg-brand-cocoa text-white font-semibold hover:bg-black transition">
                  Lanjut ke Verifikasi 2FA
                </button>
                <p className="text-[10px] text-gray-500 text-center italic">
                  Akun staf resmi: dina@littlefeat.id / kirana@littlefeat.id / fifi@littlefeat.id
                </p>
              </form>
            ) : (
              <form onSubmit={handleVerifyTOTP} className="space-y-3">
                <div className="p-3 bg-[#FAF3EC] rounded-xl border border-[#EFE2D4] text-[11px] text-[#694E40]">
                  🔐 <b>2FA Mandatori Aktif</b> untuk <b>{matchedUser.name}</b>. Masukkan 6-digit TOTP dari aplikasi autentikasi Anda (Gunakan kode <b>123456</b> untuk demo).
                </div>
                <div>
                  <label className="block font-semibold mb-1 text-center">6-Digit Code</label>
                  <input type="text" maxLength={6} value={totp} onChange={e => setTotp(e.target.value)} placeholder="123456" className="w-full p-2.5 rounded-xl border border-[#DECFC0] text-center font-mono text-lg tracking-widest" />
                </div>
                <button type="submit" className="w-full py-2.5 rounded-xl bg-brand-cocoa text-white font-semibold hover:bg-black transition">
                  Verifikasi & Masuk
                </button>
              </form>
            )}
          </div>
        </div>
      );
    }

    function CustomerLoginPage({ onSuccess }) {
      const [email, setEmail] = useState('');
      const [name, setName] = useState('');

      const handleCustLogin = (e) => {
        e.preventDefault();
        if (!email) return;
        onSuccess({
          id: `cust_${Date.now()}`,
          name: name || email.split('@')[0],
          email,
          role: 'customer'
        });
      };

      return (
        <div className="max-w-md mx-auto px-4 py-16">
          <div className="bg-white p-8 rounded-3xl border border-[#DECFC0] shadow-sm space-y-4 text-xs">
            <h2 className="font-serif text-2xl font-bold text-brand-cocoa text-center">Masuk Akun Pelanggan</h2>
            <form onSubmit={handleCustLogin} className="space-y-3">
              <div>
                <label className="block font-semibold mb-1">Nama Pemesan</label>
                <input type="text" value={name} onChange={e => setName(e.target.value)} placeholder="Sarah Wijaya" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
              </div>
              <div>
                <label className="block font-semibold mb-1">Email</label>
                <input type="email" required value={email} onChange={e => setEmail(e.target.value)} placeholder="nama@email.com" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
              </div>
              <button type="submit" className="w-full py-2.5 rounded-xl bg-brand-cocoa text-white font-semibold hover:bg-black transition">
                Masuk
              </button>
            </form>
          </div>
        </div>
      );
    }

    // =========================================================================
    // 7. TEAM PORTAL (AKUNTANSI, OPERASIONAL & PERALATAN)
    // =========================================================================
    function TeamPortal({ currentUser, bookings, journalEntries, tasks, onUpdateBookings, onUpdateJournal, onUpdateTasks }) {
      const [tab, setTab] = useState('dashboard');

      // Form Transaksi Akuntansi
      const [txType, setTxType] = useState('BEBAN');
