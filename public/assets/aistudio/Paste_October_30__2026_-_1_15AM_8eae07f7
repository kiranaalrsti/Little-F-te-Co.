    // =========================================================================
    // 4. PARTY PLANNER WIZARD (10 LANGKAH + PIC ASSIGNMENT PERSISTEN)
    // =========================================================================
    function PlannerWizard({ existingBookings, onBookingCreated }) {
      const [step, setStep] = useState(1);
      const [error, setError] = useState('');

      // State Form
      const [name, setName] = useState('');
      const [email, setEmail] = useState('');
      const [whatsapp, setWhatsapp] = useState('');
      const [contactPref, setContactPref] = useState('whatsapp');

      const [childName, setChildName] = useState('');
      const [childAge, setChildAge] = useState(3);
      const [childBirthdate, setChildBirthdate] = useState('');
      const [eventDate, setEventDate] = useState('');
      const [eventTime, setEventTime] = useState('14:00');
      const [guestCount, setGuestCount] = useState(15);
      const [notes, setNotes] = useState('');

      const [venueName, setVenueName] = useState('');
      const [venueAddress, setVenueAddress] = useState('');
      const [city, setCity] = useState('Jakarta Selatan');
      const [distanceKm, setDistanceKm] = useState(4);

      const [selectedPkgIndex, setSelectedPkgIndex] = useState(0);
      const [selectedThemeId, setSelectedThemeId] = useState('sweet_pink');
      const [extraDurationMin, setExtraDurationMin] = useState(0);

      // Add-ons
      const [cakeType, setCakeType] = useState('none');
      const [candleType, setCandleType] = useState('none');
      const [goodieType, setGoodieType] = useState('none');
      const [goodieQty, setGoodieQty] = useState(15);
      const [photoService, setPhotoService] = useState(false);

      const [agreeTerms, setAgreeTerms] = useState(false);
      const [promoConsent, setPromoConsent] = useState(false);

      useEffect(() => {
        if (goodieType !== 'none') {
          setGoodieQty(guestCount);
        }
      }, [guestCount, goodieType]);

      // Kalkulasi Otoritatif
      const pkg = INITIAL_PACKAGES[selectedPkgIndex];
      const extraChildren = Math.max(0, guestCount - pkg.capacity);
      const extraChildrenFee = extraChildren * 30000;
      const extraDurationFee = Math.max(0, Math.floor(extraDurationMin / 30)) * 75000;
      const transport = calculateTransport(distanceKm);

      let addonsList = [];
      if (cakeType === 'classic') addonsList.push({ name: 'Cake: Sweet Classic', subtotal: 100000, isStartingPrice: true, isConfirmed: false });
      if (cakeType === 'character') addonsList.push({ name: 'Cake: Little Character', subtotal: 150000, isStartingPrice: true, isConfirmed: false });
      if (cakeType === 'double') addonsList.push({ name: 'Cake: Double Delight', subtotal: 350000, isStartingPrice: true, isConfirmed: false });

      if (candleType === 'single') addonsList.push({ name: 'Lilin Angka (1 Buah)', subtotal: 10000, isStartingPrice: false, isConfirmed: true });
      if (candleType === 'pair') addonsList.push({ name: 'Lilin Angka (Sepasang)', subtotal: 20000, isStartingPrice: false, isConfirmed: true });

      if (goodieType === 'happy') addonsList.push({ name: `Goodie: Happy Snacks (${goodieQty} pcs)`, subtotal: 10000 * goodieQty, isStartingPrice: false, isConfirmed: true });
      if (goodieType === 'treats') addonsList.push({ name: `Goodie: Little Treats (${goodieQty} pcs)`, subtotal: 15000 * goodieQty, isStartingPrice: false, isConfirmed: true });
      if (goodieType === 'party') addonsList.push({ name: `Goodie: Party Treats (${goodieQty} pcs)`, subtotal: 20000 * goodieQty, isStartingPrice: false, isConfirmed: true });

      if (photoService) addonsList.push({ name: 'Party Memories Photography', subtotal: 650000, isStartingPrice: false, isConfirmed: true });

      const confirmedAddonsTotal = addonsList.filter(a => a.isConfirmed).reduce((s, a) => s + a.subtotal, 0);
      const startingAddonsTotal = addonsList.filter(a => a.isStartingPrice).reduce((s, a) => s + a.subtotal, 0);

      const confirmedTotal = pkg.price + extraChildrenFee + extraDurationFee + (transport.isConfirmed ? transport.fee : 0) + confirmedAddonsTotal;
      const estimatedTotal = confirmedTotal + startingAddonsTotal;
      const hasUnconfirmed = !transport.isConfirmed || addonsList.some(a => !a.isConfirmed);

      const handleNext = () => {
        setError('');
        if (step === 1) {
          if (!name.trim()) return setError('Nama pemesan wajib diisi.');
          if (!email.includes('@')) return setError('Email valid wajib diisi.');
          if (whatsapp.length < 9) return setError('Nomor WhatsApp valid wajib diisi.');
        }
        if (step === 2) {
          if (!childName.trim()) return setError('Nama si kecil wajib diisi.');
          if (!childBirthdate) return setError('Tanggal lahir si kecil wajib diisi.');
          if (!eventDate) return setError('Tanggal pelaksanaan acara wajib diisi.');
        }
        if (step === 3) {
          if (!venueAddress.trim()) return setError('Alamat acara wajib diisi.');
        }
        setStep(prev => Math.min(10, prev + 1));
      };

      const handleSubmit = () => {
        if (!agreeTerms) return setError('Anda wajib menyetujui syarat & ketentuan pemesanan.');
        const refCode = `LF-2026-${Math.floor(1000 + Math.random() * 9000)}`;
        const selectedThemeObj = INITIAL_DECORATION_THEMES.find(t => t.id === selectedThemeId);

        // Penugasan Persisten 1 PIC Resmi
        const assignedPIC = assignBalancedPIC(existingBookings);

        const newBooking = {
          id: `bk_${Date.now()}`,
          referenceCode: refCode,
          customerName: name,
          customerEmail: email,
          customerWhatsapp: whatsapp,
          preferredContact: contactPref,
          childName,
          childAge,
          childBirthdate,
          eventDate,
          eventStartTime: eventTime,
          guestCount,
          specialRequests: notes,
          venueName,
          venueAddress,
          cityOrDistrict: city,
          distanceKm,
          transportFee: transport.fee,
          isTransportConfirmed: transport.isConfirmed,
          packageName: pkg.name,
          packagePrice: pkg.price,
          themeName: selectedThemeObj.name,
          additionalChildrenCount: extraChildren,
          additionalChildrenFee,
          additionalDurationMinutes: extraDurationMin,
          additionalDurationFee,
          addons: addonsList,
          confirmedTotal,
          estimatedTotal,
          hasUnconfirmedItems: hasUnconfirmed,
          bookingStatus: 'Menunggu Konfirmasi',
          paymentStatus: 'Belum Dibayar',
          marketingConsent: promoConsent,
          assignedPIC, // Disimpan persisten
          createdAt: new Date().toISOString()
        };

        onBookingCreated(newBooking);
      };

      return (
        <div className="max-w-3xl mx-auto px-4 sm:px-6 py-10">
          {/* Progress Ribbon */}
          <div className="mb-6">
            <div className="flex justify-between text-xs font-bold text-brand-cocoa mb-2">
              <span>LANGKAH {step} DARI 10</span>
              <span>PARTY PLANNER LITTLE FÊTE & CO.</span>
            </div>
            <div className="w-full bg-[#E5DACD] h-2 rounded-full overflow-hidden">
              <div className="bg-brand-pinkDark h-full transition-all duration-300" style={{ width: `${(step / 10) * 100}%` }} />
            </div>
          </div>

          {error && <div className="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl">{error}</div>}

          <div className="bg-white p-6 sm:p-8 rounded-3xl border border-[#E5DACD] shadow-sm">
            {step === 1 && (
              <div className="space-y-4 text-xs">
                <h2 className="font-serif text-2xl font-bold text-brand-cocoa">Langkah 1: Informasi Kontak Pemesan</h2>
                <div>
                  <label className="block font-semibold mb-1">Nama Lengkap Orang Tua *</label>
                  <input type="text" value={name} onChange={e => setName(e.target.value)} placeholder="Contoh: Sarah Wijaya" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                </div>
                <div>
                  <label className="block font-semibold mb-1">Email Aktif *</label>
                  <input type="email" value={email} onChange={e => setEmail(e.target.value)} placeholder="nama@email.com" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                </div>
                <div>
                  <label className="block font-semibold mb-1">Nomor WhatsApp *</label>
                  <input type="tel" value={whatsapp} onChange={e => setWhatsapp(e.target.value)} placeholder="0812XXXXXXXX" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                </div>
                <div>
                  <label className="block font-semibold mb-1">Preferensi Kontak</label>
                  <select value={contactPref} onChange={e => setContactPref(e.target.value)} className="w-full p-2.5 rounded-xl border border-[#DECFC0] bg-white">
                    <option value="whatsapp">WhatsApp (Rekomendasi Cepat)</option>
                    <option value="email">Email</option>
                  </select>
                </div>
              </div>
            )}

            {step === 2 && (
              <div className="space-y-4 text-xs">
                <h2 className="font-serif text-2xl font-bold text-brand-cocoa">Langkah 2: Data Si Kecil & Waktu Acara</h2>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block font-semibold mb-1">Nama Si Kecil *</label>
                    <input type="text" value={childName} onChange={e => setChildName(e.target.value)} placeholder="Nama panggilan" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                  </div>
                  <div>
                    <label className="block font-semibold mb-1">Ulang Tahun Ke (Usia) *</label>
                    <input type="number" min="1" max="12" value={childAge} onChange={e => setChildAge(parseInt(e.target.value) || 1)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                  </div>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block font-semibold mb-1">Tanggal Lahir Si Kecil *</label>
                    <input type="date" value={childBirthdate} onChange={e => setChildBirthdate(e.target.value)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                  </div>
                  <div>
                    <label className="block font-semibold mb-1">Tanggal Pelaksanaan Acara *</label>
                    <input type="date" value={eventDate} onChange={e => setEventDate(e.target.value)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                  </div>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block font-semibold mb-1">Jam Mulai Acara (WIB) *</label>
                    <input type="time" value={eventTime} onChange={e => setEventTime(e.target.value)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                  </div>
                  <div>
                    <label className="block font-semibold mb-1">Estimasi Tamu Anak *</label>
                    <input type="number" min="5" value={guestCount} onChange={e => setGuestCount(parseInt(e.target.value) || 10)} className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
                  </div>
                </div>
                <div>
                  <label className="block font-semibold mb-1">Catatan Khusus</label>
                  <textarea rows={2} value={notes} onChange={e => setNotes(e.target.value)} placeholder="Catatan si kecil atau lokasi pesta..." className="w-full p-2 rounded-xl border border-[#DECFC0]" />
                </div>
              </div>
            )}

            {step === 3 && (
              <div className="space-y-4 text-xs">
                <h2 className="font-serif text-2xl font-bold text-brand-cocoa">Langkah 3: Lokasi Acara & Transportasi</h2>
                <div>
                  <label className="block font-semibold mb-1">Nama Tempat / Venue (Opsional)</label>
                  <input type="text" value={venueName} onChange={e => setVenueName(e.target.value)} placeholder="Rumah / Restoran" className="w-full p-2.5 rounded-xl border border-[#DECFC0]" />
