                  <div className="border-t border-[#DECFC0] pt-3 flex justify-between text-sm font-bold text-brand-cocoa">
                    <span>Total Biaya Terkonfirmasi:</span>
                    <span className="text-brand-cocoa">{formatRupiah(confirmedTotal)}</span>
