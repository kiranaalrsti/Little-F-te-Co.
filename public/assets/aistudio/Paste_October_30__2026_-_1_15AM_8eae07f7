    function calculateTransport(distanceKm) {
      if (distanceKm <= 5) return { fee: 0, isConfirmed: true, label: 'Rp0 (0–5 km Bebas Biaya)' };
      if (distanceKm <= 10) return { fee: 15000, isConfirmed: true, label: 'Rp15.000 (>5–10 km)' };
      if (distanceKm <= 15) return { fee: 25000, isConfirmed: true, label: 'Rp25.000 (>10–15 km)' };
      return { fee: 0, isConfirmed: false, label: 'Menunggu Konfirmasi Tim (>15 km)' };
    }

    // Penugasan PIC berimbang (Dina, Kirana, atau Fifi)
    function assignBalancedPIC(existingBookings) {
      const counts = { 'Dina Alawiyah': 0, 'Kirana Larasati': 0, 'Fifi Feliana': 0 };
      existingBookings.forEach(b => {
        if (b.assignedPIC && counts[b.assignedPIC] !== undefined) {
          counts[b.assignedPIC]++;
        }
      });
      let selected = 'Dina Alawiyah';
      let minVal = Infinity;
      OFFICIAL_TEAM.forEach(tm => {
        if (counts[tm.name] < minVal) {
          minVal = counts[tm.name];
          selected = tm.name;
        }
      });
      return selected;
    }

